    "drop": {"score": null, "verdict": "drop"},
    "unknown": {"score": null, "verdict": "unknown", "confidence": "low", "coordinator_counts_as": 0},
    "small_gap_le": 2,
    "clear_gap_ge": 3,
    "star_to_score": "앱 별점(1~5) × 2 = 10점 환산 (2~10)"
  },

  "candidates": {"radius_m": 1000, "count": 20, "final_top_n": 3},

  "weights": {
    "sum": 100,
    "default":               {"solo": 35, "distance": 20, "budget": 20, "preference": 15, "weather": 10, "menu": 0},
    "time_pressure":         {"solo": 30, "distance": 35, "budget": 15, "preference": 12, "weather": 8,  "menu": 0},
    "premium":               {"solo": 40, "distance": 25, "budget": 0,  "preference": 20, "weather": 15, "menu": 0},
    "premium_time_pressure": {"solo": 32, "distance": 40, "budget": 0,  "preference": 16, "weather": 12, "menu": 0},
    "mbti_multiplier": {
      "weather":    "0.5 + W",
      "preference": "1.5 - W",
      "solo":       "0.5 + B",
      "note": "W·B는 혼밥 MBTI 퍼센트(0~1). 곱한 뒤 합이 100이 되게 다시 나눈다. 퍼센트가 없으면 곱하지 않는다."
    }
  },

  "weather": {
    "feels_like_c": {"hot_soup_le": 5, "warm_le": 10, "cold_ge": 26},
    "scores": {
      "따뜻한 국물": {"따뜻한 국물": 10, "따뜻한 요리": 5,  "차가운 요리": 0},
      "따뜻한 요리": {"따뜻한 국물": 10, "따뜻한 요리": 10, "차가운 요리": 0},
      "없음":        {"따뜻한 국물": 5,  "따뜻한 요리": 5,  "차가운 요리": 5},
      "차가운 요리": {"따뜻한 국물": 0,  "따뜻한 요리": 5,  "차가운 요리": 10}
    },
    "unknown_food_type": "unknown",
    "fetch_fail": "에이전트 제외(가중치 재배분)"
  },

  "distance": {
    "walk": {"detour": 1.3, "m_per_min": 70, "round": "ceil"},
    "score": "10 - (도보분 - 후보 중 최소 도보분)",
    "score_time_pressure": "10 - 2 × (도보분 - 후보 중 최소 도보분)",
    "drop_walk_min_gt": 15,
    "objection": {"top_walk_min_gt": 7, "alt_closer_min_ge": 4, "total_gap_le": 0.5}
  },

  "budget": {
    "segment_from_mbti": {"V": "value", "P": "premium", "none": "unknown"},
    "segment_caps": {"value": 10000, "premium": null, "unknown": 13000},
    "user_budget_overrides_cap": true,
    "score": "floor(10 × 더 비싼 가게 수 ÷ (n − 1) + 0.5)",
    "min_compare": 5,
    "absolute_rule": {"le_80pct_cap": 10, "le_cap": 5},
    "premium_score": 10,
    "voc_window_months": 12,
    "voc_min_mentions": 5,
    "voc_ratio_ge": 0.5,
    "voc_adjust_max": 1,
    "voc_enabled": false,
    "stale_price_months": 12
