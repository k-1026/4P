  "preference": {
    "base": "가게 기록 평균(10점 환산) > 같은 음식 종류 평균(10점 환산) > 기록 없음 6",
    "no_record": 6,
    "review_tone_adjust": 1,
    "taste_praised_floor": 8,
    "liked_kind": {"avg_ge": 8, "count_ge": 2},
    "disliked_kind": {"avg_le": 5},
    "kind_high_confidence_count_ge": 3,
    "repeat_penalty": {"0": 3, "1": 3, "2": 1},
    "mbti": {
