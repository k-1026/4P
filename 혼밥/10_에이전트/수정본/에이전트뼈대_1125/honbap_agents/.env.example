# 이 파일을 복사해 이름을 .env로 바꾸고 키를 채운다. .env는 GitHub에 올리지 않는다.
# 비워 둔 키는 그 도구만 건너뛴다.

# Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 카카오 디벨로퍼스 > 내 애플리케이션 > 앱 키 > REST API 키 (장소 검색 + 블로그 검색)
KAKAO_REST_KEY=

# 공공데이터포털 '기상청_단기예보 조회서비스' 활용신청 > 일반 인증키(Decoding)
KMA_SERVICE_KEY=

# (선택) 네이버 개발자센터 > 검색 API (지역). 카카오에서 못 찾을 때만 씀
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# (선택) SK open API TMAP > 보행자 경로안내. 없으면 직선거리로 어림
TMAP_APP_KEY=

# (선택) 팀 데이터 위치. 비우면 data/ 또는 ../07_챗봇/의 완성본 HTML
HONBAP_DATA=
